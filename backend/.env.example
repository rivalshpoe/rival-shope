# Copy to .env and fill in real values. NEVER commit .env.
# Double underscore (__) maps to ":" in ASP.NET Core configuration (Jwt__Secret → Jwt:Secret).

# ---- Runtime ----
ASPNETCORE_ENVIRONMENT=Production

# ---- PostgreSQL (docker-compose service + API connection) ----
POSTGRES_DB=rival
POSTGRES_USER=rival
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432
# Leave empty to let docker-compose build it from the values above; set explicitly for a managed database.
ConnectionStrings__Postgres=

# ---- Redis ----
REDIS_PORT=6379
Redis__ConnectionString=redis:6379,abortConnect=false
Redis__InstanceName=rival:

# ---- Database bootstrap ----
Database__AutoMigrate=true
Database__Seed=true

# ---- JWT (admin access tokens) — at least 32 random characters ----
Jwt__Secret=change-me-generate-64-random-characters-with-openssl-rand-base64-48
Jwt__Issuer=rival-api
Jwt__Audience=rival-admin
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# ---- Anti-fraud keys ----
# HMAC-SHA256 key for device fingerprint lookup hashes (≥ 32 chars)
Security__DeviceHmacKey=change-me-generate-random-64-chars
# AES-256-GCM key, base64 of 32 random bytes:  openssl rand -base64 32
Security__AesKey=change-me-base64-32-bytes

# ---- Admin ----
Admin__Email=rivalshpoe@gmail.com

# ---- E-mail (OTP) ----
# Resend | Development (Development only logs the OTP to the console)
Email__Provider=Resend
Resend__ApiKey=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
Resend__From=Rival <no-reply@yourdomain.com>

# ---- CORS (comma or semicolon separated, or indexed: Cors__AllowedOrigins__0) ----
Cors__AllowedOrigins__0=https://rival.example.com
Cors__AllowedOrigins__1=https://www.rival.example.com

# ---- File storage: Local | Spaces ----
Storage__Provider=Local
# Public base URL used to build absolute image URLs when Storage__Provider=Local (e.g. https://api.rival.example.com)
Storage__LocalPublicBaseUrl=

# ---- DigitalOcean Spaces (when Storage__Provider=Spaces) ----
Spaces__Endpoint=https://fra1.digitaloceanspaces.com
Spaces__Region=fra1
Spaces__Bucket=
Spaces__AccessKey=
Spaces__SecretKey=
Spaces__CdnBaseUrl=https://your-space.fra1.cdn.digitaloceanspaces.com
Spaces__Folder=uploads

# ---- Optional commercial license keys (MediatR ≥ 13 / AutoMapper ≥ 15 — free community tier applies otherwise) ----
MediatR__LicenseKey=
AutoMapper__LicenseKey=
